#!/usr/bin/env bash
# jail-run — run a coding agent inside ai-jail from the current directory (which holds the
# project's .ai-jail policy), with the host's GitHub token forwarded.
set -euo pipefail

usage() {
  cat <<'EOH'
jail-run — a coding agent inside ai-jail, from the current directory
  jail-run claude [args]        Claude Code; ~/.claude and ~/.claude.json mapped rw, ~/.ssh ro
  jail-run opencode [args]      OpenCode; its own ~/.config, ~/.local/share, ~/.cache dirs mapped rw
  jail-run ocr [args]           Open Code Review; a reviewer, not an author — NO GitHub token, no
                                agent state, the project read-only, one writable dir for output
  jail-run --dry-run -- <cmd>   print the sandbox invocation ai-jail would use, run nothing
  JAIL_DRY_RUN=1                same, for a mode above: print the sandbox line, start nothing
  JAIL_CLIPBOARD=1              write-only clipboard bridge — `clip` inside the jail reaches the host
  JAIL_CLIPBOARD_PASTE=1        real X11/Wayland display passthrough — the jail can READ your clipboard
  JAIL_OCR_OUT=<dir>            ocr's one writable directory (default: $RUNNER_TEMP, else a mktemp -d)
                                It is also the jail's HOME, so ~/.opencodereview lands there.
The GitHub token is resolved on the host by gh-token and forwarded as GH_TOKEN for claude and
opencode: ~/.config/gh is never mapped in, so a login inside the jail would die with it. The ocr
mode never asks for it — OCR_LLM_URL / OCR_LLM_MODEL / OCR_LLM_TOKEN / OCR_USE_ANTHROPIC are the
only variables it gets, and only when they are set on the host.
EOH
}

self_test() {
  local fails=0 tmp fake out ocrout self
  self="$(readlink -f "$0")" # the sub-invocations below cd away, so a relative $0 would not resolve
  ok() { if [ "$1" = "$2" ]; then echo "  ok   $3"; else echo "  FAIL $3 — got '$1' want '$2'"; fails=$((fails+1)); fi; }
  # physical path: the ocr mode resolves its dirs with `pwd -P`, so the expectations must match
  tmp="$(cd "$(mktemp -d)" && pwd -P)"; fake="$tmp/bin"; mkdir -p "$fake"
  # the fakes' shebang is the running bash's real path: the Nix build sandbox has no /usr/bin/env
  printf '#!%s\n' "$(command -v bash)" > "$fake/ai-jail"
  # the args go to stdout; what the *child* inherited goes to stderr, never its value — that is
  # how the ocr mode's "no GitHub token" claim is checked, not just its absence from the flags
  # shellcheck disable=SC2016  # a script body being written out, not an expansion
  printf '%s\n' 'printf "%s\n" "$@"' \
    'printf "child-env: GH_TOKEN=%s GITHUB_TOKEN=%s\n" "${GH_TOKEN:+present}" "${GITHUB_TOKEN:+present}" >&2' \
    >> "$fake/ai-jail"; chmod +x "$fake/ai-jail"
  # a gh-token stand-in so the test does not depend on the host's login state
  printf '#!%s\n' "$(command -v bash)" > "$fake/gh-token"
  # shellcheck disable=SC2016  # a script body being written out, not an expansion
  printf '%s\n' '[ "${1:-}" = --source ] && { echo env:GH_TOKEN; exit 0; }' 'echo tok' >> "$fake/gh-token"; chmod +x "$fake/gh-token"

  ok "$(bash "$self" >/dev/null 2>&1; echo $?)" "2" "no mode is a usage error"
  ok "$(PATH="$fake:$PATH" bash "$self" --dry-run -- true 2>/dev/null | tr '\n' ' ')" "--no-save-config --dry-run -- true " "--dry-run forwards the command after -- and runs nothing else"
  out="$(cd "$tmp" && GH_TOKEN=t PATH="$fake:$PATH" bash "$self" claude --model x 2>/dev/null | tr '\n' ' ')"
  ok "$(echo "$out" | grep -c -- '--env GH_TOKEN')" "1" "claude: GH_TOKEN is forwarded by name"
  ok "$(echo "$out" | grep -c -- "--rw-map $HOME/.claude --rw-map $HOME/.claude.json --map $HOME/.ssh")" "1" "claude: its state dirs rw, ~/.ssh read-only"
  ok "$(echo "$out" | grep -c -- '--exec --env GH_TOKEN claude --model x')" "1" "claude: the agent and its args come last"
  ok "$(echo "$out" | grep -c -- '--display')" "0" "claude: no display passthrough unless asked"
  out="$(cd "$tmp" && GH_TOKEN=t JAIL_CLIPBOARD_PASTE=1 PATH="$fake:$PATH" bash "$self" claude 2>/dev/null | tr '\n' ' ')"
  ok "$(echo "$out" | grep -c -- '--display --env DISPLAY')" "1" "JAIL_CLIPBOARD_PASTE=1 adds the display flags"
  out="$(cd "$tmp" && GH_TOKEN=t PATH="$fake:$PATH" bash "$self" opencode 2>/dev/null | tr '\n' ' ')"
  ok "$(echo "$out" | grep -c -- "--rw-map $HOME/.config/opencode")" "1" "opencode: its own state dirs, not Claude's"
  ok "$(echo "$out" | grep -c -- "$HOME/.claude")" "0" "opencode: Claude's dirs are not mapped"
  ok "$(echo "$out" | grep -c -- '--exec --env GH_TOKEN opencode')" "1" "opencode: token forwarded, agent last"
  ok "$(cd "$tmp" && GH_TOKEN=t PATH="$fake:$PATH" bash "$self" claude 2>&1 >/dev/null | grep -c 'GH_TOKEN from env:GH_TOKEN')" "1" "says where the token came from, never the token"
  ok "$(cd "$tmp" && GH_TOKEN=t PATH="$fake:$PATH" bash "$self" claude 2>&1 | grep -c '^tok$')" "0" "the token value is never printed"
  out="$(cd "$tmp" && GH_TOKEN=t JAIL_CLIPBOARD=1 CLIP_SINK='cat >/dev/null' PATH="$fake:$PATH" bash "$self" claude 2>/dev/null | tr '\n' ' ')"
  ok "$(echo "$out" | grep -c -- '--exec --env GH_TOKEN claude')" "1" "JAIL_CLIPBOARD=1: the jail still starts, with a relay beside it"
  ok "$([ -p "$tmp/.tmp/clip.fifo" ] && echo present || echo gone)" "gone" "and the fifo is removed when the jail exits"
  ok "$(cd "$tmp" && GH_TOKEN=t PATH="$fake:$PATH" bash "$self" claude 2>&1 >/dev/null | grep -c 'child-env: GH_TOKEN=present')" "1" "claude: unchanged — the token is in ai-jail's own environment"

  # ocr — a reviewer, not an author: no token, no agent state, the project read-only.
  ocrout="$tmp/out"; mkdir -p "$ocrout"
  out="$(cd "$tmp" && GH_TOKEN=x GITHUB_TOKEN=x JAIL_OCR_OUT="$ocrout" PATH="$fake:$PATH" bash "$self" ocr review --format json 2>/dev/null | tr '\n' ' ')"
  ok "$(echo "$out" | grep -c -- 'GH_TOKEN\|GITHUB_TOKEN')" "0" "ocr: no GitHub token anywhere on the sandbox line"
  ok "$(cd "$tmp" && GH_TOKEN=x GITHUB_TOKEN=x JAIL_OCR_OUT="$ocrout" PATH="$fake:$PATH" bash "$self" ocr 2>&1 >/dev/null | grep -c 'child-env: GH_TOKEN= GITHUB_TOKEN=$')" "1" "ocr: and both are unset in the child's environment, not merely unflagged"
  ok "$(echo "$out" | grep -c -- "$HOME/.claude")" "0" "ocr: Claude's state dirs are not mapped"
  ok "$(echo "$out" | grep -c -- "--map $tmp --rw-map $ocrout")" "1" "ocr: the project read-only, then the one writable dir"
  ok "$(echo "$out" | grep -c -- "--env HOME=$ocrout")" "1" "ocr: HOME points at it, so ~/.opencodereview is not the host's"
  ok "$(echo "$out" | grep -c -- '--clean --private-home --no-agent-state')" "1" "ocr: the reviewed repo's own .ai-jail cannot add mounts"
  ok "$(echo "$out" | grep -c -- '--network')" "1" "ocr: network stays on — the reviewer has to reach Ollama"
  ok "$(echo "$out" | grep -c -- '--exec ocr review --format json')" "1" "ocr: the tool and its args come last"
  out="$(cd "$tmp" && JAIL_OCR_OUT="$ocrout" OCR_LLM_URL=u OCR_LLM_MODEL=m PATH="$fake:$PATH" bash "$self" ocr 2>/dev/null | tr '\n' ' ')"
  ok "$(echo "$out" | grep -c -- '--env OCR_LLM_URL --env OCR_LLM_MODEL')" "1" "ocr: the LLM variables that are set are passed by name"
  ok "$(echo "$out" | grep -c -- 'OCR_LLM_TOKEN')" "0" "ocr: the ones that are not set are not invented"
  rm -rf "$tmp"
  if [ "$fails" -eq 0 ]; then echo "jail-run self-test: ok"; return 0; fi
  echo "jail-run self-test: $fails failure(s)" >&2; return 1
}

mode="${1:-}"
case "$mode" in
  --self-test) self_test; exit $? ;;
  --help|-h)   usage; exit 0 ;;
  --dry-run)   shift; [ "${1:-}" = "--" ] && shift; ai-jail --no-save-config --dry-run -- "$@"; exit $? ;;
  claude|opencode|ocr) shift ;;
  *)           usage >&2; exit 2 ;;
esac

dry_flags=()
[ "${JAIL_DRY_RUN:-0}" = "1" ] && dry_flags=(--dry-run)

relay_pid=""
cleanup() {
  if [ -n "$relay_pid" ]; then
    kill -TERM "$relay_pid" 2>/dev/null || true
    wait "$relay_pid" 2>/dev/null || true
  fi
  rm -f .tmp/clip.fifo
}
trap cleanup EXIT INT TERM

# The fifo lives under the project's .tmp/: the project directory is what ai-jail maps into the
# sandbox, so a path under $XDG_RUNTIME_DIR would be invisible from inside.
if [ "$mode" = claude ] && [ "${JAIL_CLIPBOARD:-0}" = "1" ]; then
  mkdir -p .tmp
  fifo=".tmp/clip.fifo"
  rm -f "$fifo"
  mkfifo "$fifo"
  clip-relay "$fifo" &
  relay_pid=$!
  sleep 0.2
  if ! kill -0 "$relay_pid" 2>/dev/null; then
    wait "$relay_pid" 2>/dev/null || true
    relay_pid=""
  fi
fi

ocr_out=""
ocr_env=()
if [ "$mode" = ocr ]; then
  ocr_out="${JAIL_OCR_OUT:-${RUNNER_TEMP:-}}"
  [ -n "$ocr_out" ] || ocr_out="$(mktemp -d)"
  mkdir -p "$ocr_out"
  ocr_out="$(cd "$ocr_out" && pwd -P)" # ai-jail mounts the path it is given; a symlink is not one
  for v in OCR_LLM_URL OCR_LLM_MODEL OCR_LLM_TOKEN OCR_USE_ANTHROPIC; do
    if [ -n "${!v:-}" ]; then ocr_env+=(--env "$v"); fi
  done
  echo "jail-run: ocr — $PWD read-only, $ocr_out writable (and HOME, so ~/.opencodereview is there), no GitHub token" >&2
fi

paste_flags=()
if [ "${JAIL_CLIPBOARD_PASTE:-0}" = "1" ]; then
  echo "jail-run: JAIL_CLIPBOARD_PASTE=1 — real X11/Wayland display passthrough is on, the jail can read your clipboard (and, on X11, more)" >&2
  paste_flags=(--display --env DISPLAY --env WAYLAND_DISPLAY --env "XDG_RUNTIME_DIR=/run/user/$(id -u)")
fi

if [ "$mode" != ocr ]; then
  if src="$(gh-token --source)"; then
    GH_TOKEN="$(gh-token)"
    export GH_TOKEN
    echo "jail-run: GH_TOKEN from $src — gh works inside the jail, no login needed" >&2
  else
    echo "jail-run: no GitHub token (no GH_TOKEN in the environment, and gh is logged out on the host)." >&2
    echo "          gh will not work inside the jail. Fix once, on the host: gh auth login   (or export GH_TOKEN)" >&2
  fi
fi

case "$mode" in
  claude)
    ai-jail --no-save-config --rw-map ~/.claude --rw-map ~/.claude.json --map ~/.ssh --network --terminal-passthrough "${dry_flags[@]}" --exec --env GH_TOKEN "${paste_flags[@]}" claude "$@" ;;
  opencode)
    ai-jail --no-save-config --rw-map ~/.config/opencode --rw-map ~/.local/share/opencode --rw-map ~/.cache/opencode --network --terminal-passthrough "${dry_flags[@]}" --exec --env GH_TOKEN opencode "$@" ;;
  ocr)
    # A reviewer gets read access and one place to write, and nothing else. --clean is load-bearing:
    # without it the *reviewed* project's own .ai-jail is merged in, and marola's asks for
    # ~/.claude rw — the repo under review would be choosing the reviewer's mounts. That also drops
    # its `mask` list, so the secret patterns are restated here.
    # --map "$PWD" after ai-jail's own rw bind of the project is what makes it read-only (verified
    # against ai-jail's dry-run: the ro-bind and the --landlock-ro-path both land on the project).
    # --network is all or nothing in ai-jail 126a67e: --allow-tcp-port is refused outright ("UDP
    # cannot be isolated") and --lockdown, which does deny TCP, throws away --rw-map. So the jail
    # reaches 127.0.0.1:11434 and, honestly, everything else the host can reach.
    env -u GH_TOKEN -u GITHUB_TOKEN \
      ai-jail --no-save-config --clean --private-home --no-agent-state \
      --mask .env --mask '.env.*' --mask '*.pem' --mask '*.key' \
      --map "$PWD" --rw-map "$ocr_out" --env "HOME=$ocr_out" "${ocr_env[@]}" \
      --network "${dry_flags[@]}" --exec ocr "$@" ;;
esac
