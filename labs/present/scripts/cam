#!/usr/bin/env bash
# cam — webcam controls you can save and get back, over v4l2-ctl.
#
# Webcams forget brightness, zoom and manual focus on unplug and on suspend, and every camera
# names its controls differently, so the thing you want two minutes before a call is "the
# settings from last time", not the v4l2-ctl man page.
#
#   cam list                                   devices and their /dev/video* nodes
#   cam show [dev]                             every writable control: value, default, range
#   cam set  [dev] name=value [name=value…]    one control at a time, so a bad one names itself
#   cam save <profile> [dev]                   current values → ~/.config/present/cam/<profile>.conf
#   cam load <profile> [dev]                   apply a saved profile (auto-* controls first)
#   cam reset [dev]                            every writable control back to its default
#
# dev defaults to $CAM_DEVICE, then /dev/video0. Profiles are plain `name=value` lines, one per
# control — edit them by hand. v4l2-ctl is resolved from PATH (the lab's shell puts v4l-utils
# there); the flake deliberately does not wrap it in, so --self-test can fake it.
set -euo pipefail

profiles="${XDG_CONFIG_HOME:-$HOME/.config}/present/cam"

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }

# Splits an optional leading /dev/… argument off; sets $dev and $rest (an array).
take_dev() {
  dev="${CAM_DEVICE:-/dev/video0}"; rest=()
  if [ $# -gt 0 ] && [[ "$1" == /dev/* ]]; then dev="$1"; shift; fi
  rest=("$@")
}

# v4l2-ctl --list-ctrls → "name type value default flags", one line per control that has a
# value. Headers ("User Controls") have no 0x id and are dropped; read-only and inactive
# controls are kept but flagged so save/reset can skip them.
controls() {
  v4l2-ctl -d "$1" --list-ctrls | awk '
    $2 ~ /^0x/ {
      type = $3; gsub(/[()]/, "", type)
      value = "-"; def = "-"; flags = "-"
      for (i = 4; i <= NF; i++) {
        if ($i ~ /^value=/)   { value = substr($i, 7) }
        if ($i ~ /^default=/) { def   = substr($i, 9) }
      }
      # flags is last and may contain spaces ("flags=inactive, has-min-max" on v4l-utils 1.32)
      if (match($0, /flags=.*/)) { flags = substr($0, RSTART + 6); gsub(/ /, "", flags) }
      if (value != "-") print $1, type, value, def, flags
    }'
}

writable() { awk '$5 !~ /read-only|inactive|volatile/'; }

# auto-* controls first: setting focus_absolute while focus_automatic_continuous=1 fails on most
# cameras, and the same for exposure and white balance.
auto_first() { awk '{ print ($1 ~ /auto/ ? 0 : 1), $0 }' | sort -s -k1,1n | cut -d' ' -f2-; }

set_ctrl() { # dev name=value
  v4l2-ctl -d "$1" --set-ctrl="$2" || { echo "cam: $1: could not set $2" >&2; return 1; }
  echo "  $2"
}

cmd_list() { v4l2-ctl --list-devices; }

cmd_show() {
  take_dev "$@"
  echo "$dev"
  controls "$dev" | awk '{ printf "  %-32s %8s  (default %s%s)\n", $1, $3, $4, ($5 == "-" ? "" : ", " $5) }'
}

cmd_set() {
  take_dev "$@"
  [ ${#rest[@]} -gt 0 ] || { echo "cam set: nothing to set" >&2; exit 2; }
  echo "$dev"
  for kv in "${rest[@]}"; do set_ctrl "$dev" "$kv"; done
}

cmd_save() {
  [ $# -ge 1 ] || { echo "cam save: profile name required" >&2; exit 2; }
  local name="$1"; shift; take_dev "$@"
  mkdir -p "$profiles"
  { echo "# cam profile '$name' from $dev, $(date -u +%Y-%m-%dT%H:%MZ)"
    controls "$dev" | writable | auto_first | awk '{ print $1 "=" $3 }'
  } > "$profiles/$name.conf"
  echo "$profiles/$name.conf"
}

cmd_load() {
  [ $# -ge 1 ] || { echo "cam load: profile name required" >&2; exit 2; }
  local name="$1" file; shift; take_dev "$@"
  file="$profiles/$name.conf"
  [ -f "$file" ] || { echo "cam load: no profile $file" >&2; exit 1; }
  echo "$dev ← $file"
  grep -v '^#' "$file" | grep '=' | while IFS= read -r kv; do set_ctrl "$dev" "$kv"; done
}

cmd_reset() {
  take_dev "$@"
  echo "$dev → defaults"
  controls "$dev" | writable | auto_first | awk '$4 != "-" { print $1 "=" $4 }' \
    | while IFS= read -r kv; do set_ctrl "$dev" "$kv"; done
}

self_test() {
  local fails=0 tmp fake log
  ok() { if [ "$1" = "$2" ]; then echo "  ok   $3"; else echo "  FAIL $3 — got '$1' want '$2'"; fails=$((fails+1)); fi; }

  tmp="$(mktemp -d)"; fake="$tmp/bin"; log="$tmp/set.log"; mkdir -p "$fake"
  # The fake's shebang is the running bash's real path: the Nix build sandbox has no /usr/bin/env.
  # It answers --list-devices and --list-ctrls with a real camera's output, appends every
  # --set-ctrl to a log, and refuses one control so the error path is exercised.
  printf '#!%s\n' "$(command -v bash)" > "$fake/v4l2-ctl"
  cat >> "$fake/v4l2-ctl" <<EOF
case "\$*" in
  *--list-devices*) printf 'HD Pro Webcam C920 (usb-0000:00:14.0-1):\n\t/dev/video0\n\t/dev/video1\n'; exit 0 ;;
  *--set-ctrl=zoom_absolute=999*) exit 1 ;;
  *--set-ctrl=*) a="\$*"; printf '%s\n' "\${a##*--set-ctrl=}" >> "$log"; exit 0 ;;
  *--list-ctrls*) cat <<'CTRLS'

User Controls

                     brightness 0x00980900 (int)    : min=0 max=255 step=1 default=128 value=140
                       contrast 0x00980901 (int)    : min=0 max=255 step=1 default=128 value=128
        white_balance_automatic 0x0098090c (bool)   : default=1 value=1
           power_line_frequency 0x00980918 (menu)   : min=0 max=2 default=2 value=2 (60 Hz)
      white_balance_temperature 0x0098091a (int)    : min=2000 max=6500 step=1 default=4000 value=4000 flags=inactive, has-min-max

Camera Controls

                  auto_exposure 0x009a0901 (menu)   : min=0 max=3 default=3 value=3 (Aperture Priority Mode)
                 focus_absolute 0x009a090a (int)    : min=0 max=250 step=5 default=0 value=30
     focus_automatic_continuous 0x009a090c (bool)   : default=1 value=0
                  zoom_absolute 0x009a090d (int)    : min=100 max=500 step=1 default=100 value=120
                     led1_mode 0x0a046d05 (menu)   : min=0 max=3 default=0 value=0 flags=read-only
CTRLS
    exit 0 ;;
esac
exit 1
EOF
  chmod +x "$fake/v4l2-ctl"
  export PATH="$fake:$PATH" XDG_CONFIG_HOME="$tmp/cfg" CAM_DEVICE=/dev/video0

  ok "$(bash "$0" list | head -1)" "HD Pro Webcam C920 (usb-0000:00:14.0-1):" "list passes v4l2-ctl --list-devices through"
  ok "$(bash "$0" show | grep -c '^  ')" "10" "show prints one line per control that has a value, headers dropped"
  ok "$(bash "$0" show | awk '$1 == "focus_absolute" { print $2 }')" "30" "show reads the current value, not the default"
  ok "$(bash "$0" show | grep led1_mode | grep -o 'read-only')" "read-only" "show flags read-only controls instead of hiding them"
  ok "$(bash "$0" show | awk '$1 == "white_balance_temperature" { print $NF }')" "inactive,has-min-max)" "multi-word flags are kept whole"

  : > "$log"
  ok "$(bash "$0" set brightness=150 focus_absolute=40 | tail -1)" "  focus_absolute=40" "set applies each control and echoes it"
  ok "$(tr '\n' ' ' < "$log")" "brightness=150 focus_absolute=40 " "…one --set-ctrl per control, in the order given"
  ok "$(bash "$0" set /dev/video1 contrast=1 >/dev/null; bash "$0" show /dev/video1 | head -1)" "/dev/video1" "a leading /dev/… argument selects the device"
  ok "$(bash "$0" set zoom_absolute=999 2>&1 >/dev/null || true)" "cam: /dev/video0: could not set zoom_absolute=999" "a rejected control names itself and fails"

  ok "$(bash "$0" save meeting)" "$tmp/cfg/present/cam/meeting.conf" "save writes the profile under XDG_CONFIG_HOME"
  ok "$(grep -v '^#' "$tmp/cfg/present/cam/meeting.conf" | head -3 | tr '\n' ' ')" \
     "white_balance_automatic=1 auto_exposure=3 focus_automatic_continuous=0 " \
     "…auto controls come first so manual values are accepted on load"
  ok "$(grep -c -e white_balance_temperature -e led1_mode "$tmp/cfg/present/cam/meeting.conf")" "0" \
     "…inactive and read-only controls are not saved"
  ok "$(grep -c '=' "$tmp/cfg/present/cam/meeting.conf")" "8" "…every other control is"

  : > "$log"
  ok "$(bash "$0" load meeting | tail -1)" "  zoom_absolute=120" "load replays the profile"
  ok "$(head -1 "$log")" "white_balance_automatic=1" "…auto controls first"
  ok "$(bash "$0" load nope 2>&1 || true)" "cam load: no profile $tmp/cfg/present/cam/nope.conf" "a missing profile is an error, not a no-op"

  : > "$log"
  ok "$(bash "$0" reset >/dev/null; grep -c . "$log")" "8" "reset sets every writable control"
  ok "$(grep focus_absolute "$log")" "focus_absolute=0" "…to its default, not its current value"
  ok "$(grep -c led1_mode "$log")" "0" "…and skips read-only ones"

  rm -rf "$tmp"
  if [ "$fails" -eq 0 ]; then echo "cam self-test ok"; else echo "cam self-test: $fails failed"; exit 1; fi
}

case "${1:-}" in
  list)         shift; cmd_list "$@" ;;
  show)         shift; cmd_show "$@" ;;
  set)          shift; cmd_set "$@" ;;
  save)         shift; cmd_save "$@" ;;
  load)         shift; cmd_load "$@" ;;
  reset)        shift; cmd_reset "$@" ;;
  --self-test)  self_test ;;
  -h|--help|"") usage ;;
  *)            echo "cam: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
