#!/usr/bin/env bash
# viz: the code graph of a repository with graphify, the marola-devkit way: code-only, no API key,
# no model, written under ~/.cache and never into the checkout. `viz --help` lists the commands.
set -euo pipefail

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Baked in by the lab's writeShellApplication; from source the literal misses and PATH is used.
GRAPHIFY="${GRAPHIFY:-@graphify@}"
case "$GRAPHIFY" in @*@) GRAPHIFY=graphify ;; esac

usage() {
  cat <<'EOH'
viz — the code graph of a repository with graphify (code-only, keyless, offline)
  viz build [dir]                         extract and cluster <dir> (default .)
  viz query "<question>"                  answer from the graph, capped at --budget 400
  viz path <a> <b> | explain <x> | ...    any other graphify command, on the same graph
  viz where                               the output directory (graph.json, graph.html)
VIZ_OUT overrides the output directory (default ~/.cache/marola-graph/<repo>).
EOH
}

out_dir() {
  local root
  root="$(git -C "${1:-.}" rev-parse --show-toplevel 2>/dev/null || (cd "${1:-.}" && pwd))"
  echo "${VIZ_OUT:-${XDG_CACHE_HOME:-$HOME/.cache}/marola-graph/$(basename "$root")}"
}

# env -i: graphify reads provider keys from the environment, and the LLM pass is what costs tokens.
# The discard port makes any model call fail at once instead of reaching a local Ollama.
g() {
  local out=$1; shift
  env -i PATH="$PATH" HOME="$out" GRAPHIFY_OUT="$out" GRAPHIFY_NO_AUTO_REFRESH=1 PYTHONHASHSEED=0 \
    OLLAMA_BASE_URL=http://127.0.0.1:9 "$GRAPHIFY" "$@"
}

main() {
  local cmd="${1:-build}"; [ $# -gt 0 ] && shift
  case "$cmd" in
    -h|--help|help) usage ;;
    --self-test) self_test ;;
    where) out_dir . ;;
    build)
      local dir="${1:-.}" out
      out="$(out_dir "$dir")"; mkdir -p "$out"
      g "$out" extract "$dir" --code-only --no-label
      g "$out" cluster-only "$dir" --no-label --graph "$out/graph.json"
      echo "viz: $out/graph.html"
      ;;
    query)
      local out; out="$(out_dir .)"
      g "$out" query "$@" --graph "$out/graph.json" --budget 400
      ;;
    *)
      local out; out="$(out_dir .)"
      g "$out" "$cmd" "$@" --graph "$out/graph.json"
      ;;
  esac
}

# A fake graphify on PATH records its arguments and environment; nothing real runs.
self_test() {
  t="$(mktemp -d)"; trap 'rm -rf "$t"' EXIT
  mkdir -p "$t/bin" "$t/repo"
  # The Nix sandbox has no /usr/bin/env, so the fake names this bash.
  echo "#!$BASH" >"$t/bin/graphify"
  cat >>"$t/bin/graphify" <<'EOF'
echo "$* | out=$GRAPHIFY_OUT seed=$PYTHONHASHSEED key=${ANTHROPIC_API_KEY:-none}" >>"$GRAPHIFY_OUT/calls"
EOF
  chmod +x "$t/bin/graphify"
  local fail=0
  check() { if grep -qF -- "$2" "$t/out/calls"; then echo "ok   $1"; else echo "FAIL $1: no '$2' in calls"; cat "$t/out/calls"; fail=1; fi; }

  (cd "$t/repo" && PATH="$t/bin:$PATH" GRAPHIFY="$t/bin/graphify" VIZ_OUT="$t/out" ANTHROPIC_API_KEY=secret \
    "$self" build . >/dev/null)
  check "build extracts code only" "extract . --code-only --no-label | out=$t/out seed=0 key=none"
  check "build clusters into graph.json" "cluster-only . --no-label --graph $t/out/graph.json"
  (cd "$t/repo" && PATH="$t/bin:$PATH" GRAPHIFY="$t/bin/graphify" VIZ_OUT="$t/out" "$self" query "where is x" >/dev/null)
  check "query is capped" "query where is x --graph $t/out/graph.json --budget 400"
  (cd "$t/repo" && PATH="$t/bin:$PATH" GRAPHIFY="$t/bin/graphify" VIZ_OUT="$t/out" "$self" path a b >/dev/null)
  check "other commands pass through" "path a b --graph $t/out/graph.json"
  if [ "$(cd "$t/repo" && XDG_CACHE_HOME="$t/cache" "$self" where)" = "$t/cache/marola-graph/repo" ]; then
    echo "ok   where defaults to the cache"
  else echo "FAIL where"; fail=1; fi
  [ "$fail" -eq 0 ] && echo "viz: self-test passed"
  return "$fail"
}

main "$@"
